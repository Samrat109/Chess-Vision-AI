{
  "manifest_version": 3,
  "name": "ChessVision AI",
  "version": "1.1.0",
  "description": "Stockfish-powered chess analysis and coaching for completed games and training.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8001/*",
    "http://localhost:8001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChessVision AI"
  }
}